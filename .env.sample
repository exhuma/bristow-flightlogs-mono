# Copy to `.env` (gitignored) and adjust as needed. All values are
# optional; the defaults below are what the Taskfile uses when a
# variable is unset. On this shared host, override any port that is
# already taken by another dev process.

# Backend dev server (uvicorn)
#BACKEND_PORT=8210

# Frontend dev server (vite)
#FRONTEND_PORT=8211

# Dev PostgreSQL container (published host port)
#DB_PORT=8212

# Disposable test PostgreSQL container (published host port)
#TEST_DB_PORT=8213

# Prefix for docker container/volume names. Must be unique per
# developer on a shared host. Default: flightlogs-<your username>
#CONTAINER_PREFIX=flightlogs-claude

# Optional OIDC wiring for `task dev:backend`, e.g. a local Keycloak
# (realm/users as created by backend/.devcontainer/init-keycloak.py).
# With these unset, the backend runs with dev-auth (HTTP Basic) only.
#FLIGHTLOGS_OIDC_AUTHORITY=http://localhost:8214/realms/test-app
#FLIGHTLOGS_OIDC_CLIENT_ID=flight-logs-web
#FLIGHTLOGS_ADMIN_EMAIL=user@example.com
